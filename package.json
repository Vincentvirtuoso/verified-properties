{
  "name": "affilhomes",
  "private": true,
  "workspaces": [
    "client",
    "admin",
    "shared"
  ],
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "dev": "concurrently -n client,admin -c blue,green \"npm run dev -w client\" \"npm run dev -w admin\"",
    "dev:client": "npm run dev -w client",
    "dev:admin": "npm run dev -w admin"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "eslint-config-next": "^16.4.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
